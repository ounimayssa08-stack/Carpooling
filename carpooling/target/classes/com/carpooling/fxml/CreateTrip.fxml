<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carpooling.controller.TripController"
      styleClass="view-root" spacing="20" maxWidth="600"
      alignment="TOP_CENTER">

    <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

    <Label text="➕ Créer un Nouveau Trajet" styleClass="view-title"/>

    <VBox styleClass="form-card" spacing="16">

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Ville de départ" styleClass="field-label"/>
                <TextField fx:id="departureField" promptText="ex. Tunis"
                           styleClass="text-field-styled" id="tripDepartureField"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Ville d'arrivée" styleClass="field-label"/>
                <TextField fx:id="destinationField" promptText="ex. Sousse"
                           styleClass="text-field-styled" id="tripDestinationField"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Date" styleClass="field-label"/>
                <DatePicker fx:id="datePicker" maxWidth="Infinity"
                            styleClass="date-picker-styled" id="tripDatePicker"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Hour" styleClass="field-label"/>
                <Spinner fx:id="timeHourSpinner" prefWidth="70"
                         styleClass="spinner-styled" editable="true" id="tripHourSpinner"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Min" styleClass="field-label"/>
                <Spinner fx:id="timeMinuteSpinner" prefWidth="70"
                         styleClass="spinner-styled" editable="true" id="tripMinSpinner"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Places disponibles" styleClass="field-label"/>
                <Spinner fx:id="seatsSpinner" maxWidth="Infinity"
                         styleClass="spinner-styled" editable="true" id="tripSeatsSpinner"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Prix par place (TND)" styleClass="field-label"/>
                <TextField fx:id="priceField" promptText="0.000"
                           styleClass="text-field-styled" id="tripPriceField"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Véhicule" styleClass="field-label"/>
            <ChoiceBox fx:id="vehicleChoiceBox" maxWidth="Infinity"
                       styleClass="choice-box-styled" id="tripVehicleChoice"/>
        </VBox>

        <Button fx:id="createButton" text="🚗 Créer le Trajet" onAction="#handleCreate"
                styleClass="btn-primary" maxWidth="Infinity" id="createTripBtn"/>
    </VBox>
</VBox>

