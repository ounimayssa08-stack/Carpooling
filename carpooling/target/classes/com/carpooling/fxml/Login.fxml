<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.carpooling.controller.LoginController"
           styleClass="auth-root">

    <VBox styleClass="auth-card" alignment="CENTER" spacing="0">

        <!-- Header -->
        <VBox alignment="CENTER" styleClass="auth-header" spacing="4">
            <Label text="🚗" styleClass="auth-logo"/>
            <Label text="Covoiturage" styleClass="auth-title"/>
            <Label text="Partagez vos trajets, économisez" styleClass="auth-subtitle"/>
        </VBox>

        <!-- Form -->
        <VBox spacing="16" styleClass="auth-form">
            <VBox spacing="6">
                <Label text="Adresse Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="vous@exemple.com"
                           styleClass="text-field-styled" id="loginEmailField"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               styleClass="text-field-styled" id="loginPasswordField"/>
            </VBox>

            <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin"
                    styleClass="btn-primary" maxWidth="Infinity" id="loginButton"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Pas encore de compte ?" styleClass="text-muted"/>
                <Hyperlink fx:id="registerLink" text="Créer un compte"
                           onAction="#handleRegisterLink" styleClass="link"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>

