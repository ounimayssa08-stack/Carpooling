<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpooling.controller.ManageReservationsController" styleClass="root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gérer les Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -cp-text;"/>

    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" prefHeight="300" prefWidth="400">
        <columns>
            <TableColumn fx:id="passengerCol" text="Passager" prefWidth="150"/>
            <TableColumn fx:id="seatsCol" text="Places" prefWidth="80"/>
            <TableColumn fx:id="statusCol" text="Statut" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Refuser" onAction="#handleRefuse" styleClass="button-secondary" style="-fx-text-fill: -cp-danger;"/>
        <Button text="Accepter" onAction="#handleAccept" styleClass="button-primary"/>
    </HBox>
    <HBox alignment="CENTER_RIGHT">
        <Button text="Fermer" onAction="#handleClose" styleClass="button-secondary"/>
    </HBox>
</VBox>
