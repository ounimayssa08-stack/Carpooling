<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpooling.controller.PaymentMethodController" styleClass="root">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Ajouter un moyen de paiement" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -cp-text;"/>
    <Label text="Nécessaire pour confirmer vos réservations." style="-fx-text-fill: -cp-text-muted; -fx-font-size: 12px;"/>

    <VBox spacing="5" maxWidth="300">
        <Label text="Numéro de carte" style="-fx-text-fill: -cp-text;"/>
        <TextField fx:id="cardNumberField" promptText="0000 0000 0000 0000" styleClass="input-field"/>
    </VBox>

    <HBox spacing="10" maxWidth="300">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Expiration" style="-fx-text-fill: -cp-text;"/>
            <TextField fx:id="expiryField" promptText="MM/YY" styleClass="input-field"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="CVV" style="-fx-text-fill: -cp-text;"/>
            <TextField fx:id="cvvField" promptText="123" styleClass="input-field"/>
        </VBox>
    </HBox>

    <HBox spacing="15" alignment="CENTER_RIGHT" maxWidth="300" style="-fx-padding: 10 0 0 0;">
        <Button text="Annuler" onAction="#handleCancel" styleClass="button-secondary"/>
        <Button text="Sauvegarder" onAction="#handleSavePayment" styleClass="button-primary"/>
    </HBox>
</VBox>
