<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="view-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.carpooling.controller.AdminStatsController">
    <VBox spacing="25">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <Label text="📊 Statistiques Plateforme" styleClass="view-title"/>

        <!-- Metrics Grid -->
        <FlowPane hgap="20" vgap="20">
            <VBox styleClass="stats-card" prefWidth="200" spacing="10">
                <Label text="Revenu Total" styleClass="stats-label"/>
                <Label fx:id="totalRevenueLbl" text="0.00 TND" styleClass="stats-value" style="-fx-text-fill: #2ECC71;"/>
            </VBox>
            <VBox styleClass="stats-card" prefWidth="200" spacing="10">
                <Label text="Trajets Totaux" styleClass="stats-label"/>
                <Label fx:id="totalTripsLbl" text="0" styleClass="stats-value"/>
            </VBox>
            <VBox styleClass="stats-card" prefWidth="200" spacing="10">
                <Label text="Trajets en cours" styleClass="stats-label"/>
                <Label fx:id="activeTripsLbl" text="0" styleClass="stats-value" style="-fx-text-fill: #E67E22;"/>
            </VBox>
            <VBox styleClass="stats-card" prefWidth="200" spacing="10">
                <Label text="Utilisateurs" styleClass="stats-label"/>
                <Label fx:id="totalUsersLbl" text="0" styleClass="stats-value"/>
            </VBox>
            <VBox styleClass="stats-card" prefWidth="200" spacing="10">
                <Label text="Réservations" styleClass="stats-label"/>
                <Label fx:id="totalReservationsLbl" text="0" styleClass="stats-value" style="-fx-text-fill: -cp-accent;"/>
            </VBox>
        </FlowPane>

        <!-- Charts Row -->
        <HBox spacing="25">
            <VBox styleClass="form-card" HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Trajets par jour (7 derniers)" styleClass="card-title"/>
                <BarChart fx:id="tripsChart" prefHeight="300">
                    <xAxis><CategoryAxis label="Jour"/></xAxis>
                    <yAxis><NumberAxis label="Nombre"/></yAxis>
                </BarChart>
            </VBox>
            <VBox styleClass="form-card" prefWidth="400" spacing="10">
                <Label text="Répartition Utilisateurs" styleClass="card-title"/>
                <PieChart fx:id="usersPieChart" prefHeight="300"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
