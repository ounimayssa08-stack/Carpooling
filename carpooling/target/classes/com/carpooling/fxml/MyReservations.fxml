<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carpooling.controller.ReservationController"
      styleClass="view-root" spacing="16">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="📋 Mes Réservations" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Actualiser" onAction="#handleRefresh"
                styleClass="btn-secondary" id="refreshReservationsBtn"/>
    </HBox>

    <ListView fx:id="reservationListView" VBox.vgrow="ALWAYS" styleClass="list-view-styled">
        <placeholder><Label text="Aucune réservation pour le moment." styleClass="text-muted"/></placeholder>
    </ListView>

    <HBox spacing="12">
        <Button fx:id="rateButton" text="⭐ Évaluer le conducteur" onAction="#handleReview"
                styleClass="btn-primary" id="rateDriverBtn"/>
        <Button fx:id="cancelButton" text="❌ Annuler la Réservation" onAction="#handleCancel"
                styleClass="btn-danger" id="cancelReservationBtn"/>
    </HBox>
</VBox>

