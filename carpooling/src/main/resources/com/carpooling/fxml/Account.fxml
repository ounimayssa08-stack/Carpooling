<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carpooling.controller.AccountController"
      styleClass="view-root" spacing="20">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="👤 Mon Compte" styleClass="view-title"/>

    <VBox spacing="15" maxWidth="500" styleClass="form-card">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label fx:id="roleLabel" text="Rôle: Passenger" style="-fx-font-weight: bold; -fx-text-fill: -cp-accent;"/>
        
        <VBox fx:id="driverStatsBox" spacing="5">
            <Label text="Votre Note Conducteur:" styleClass="field-label"/>
            <Label fx:id="ratingLabel" text="0.0 ⭐" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>

        <Separator/>

        <VBox spacing="5">
            <Label text="Nom complet" styleClass="field-label"/>
            <TextField fx:id="nameField" styleClass="text-field-styled"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" styleClass="text-field-styled"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Nouveau mot de passe (laisser vide pour ne pas changer)" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" styleClass="text-field-styled"/>
        </VBox>

        <Button text="Mettre à jour le profil" onAction="#handleUpdateProfile"
                styleClass="btn-primary" maxWidth="Infinity" style="-fx-margin-top: 10;"/>
    </VBox>
</VBox>
