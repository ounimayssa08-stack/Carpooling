<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.carpooling.controller.NotificationsController"
      styleClass="view-root" spacing="20">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="🔔 Notifications" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Actualiser" onAction="#handleRefresh" styleClass="btn-secondary"/>
    </HBox>

    <ListView fx:id="notificationListView" VBox.vgrow="ALWAYS" styleClass="list-view-styled">
        <placeholder><Label text="Aucune notification." styleClass="text-muted"/></placeholder>
    </ListView>
</VBox>
